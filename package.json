{
  "name": "dsh-skill-panel",
  "version": "1.1.0",
  "description": "Skill visual panel: view each skill's flow and raw text as cards, and edit/save them in place (old version backed up as .bak).",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill"
  ],
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "技能记忆层 Skill Panel",
    "summary": "把 agent 经验沉淀为可复用的 skill：卡片管理、多选组合、垃圾清理、用量排序、价值估算账本。",
    "categories": [
      "效率",
      "技能",
      "Workflow"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:skill-panel"
      ]
    },
    "permissions": {},
    "compatibility": {
      "dsh": ">=0.1.2-rc.1",
      "node": ">=20"
    }
  }
}
